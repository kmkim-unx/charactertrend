# UNX Character Tracker 환경변수
# 이 파일을 .env 로 복사 후 값을 채우세요: cp .env.example .env

# OpenAI (G3/G4/G5 분석에 사용)
OPENAI_API_KEY=sk-...

# Notion Integration
# 통합(Integration) 토큰: https://www.notion.so/my-integrations
NOTION_API_KEY=secret_...
# 대상 데이터베이스 ID (URL의 32자리 hex)
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

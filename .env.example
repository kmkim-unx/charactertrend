# API 키 설정 예시
# 이 파일을 .env로 복사하고 실제 키를 입력하세요
# cp .env.example .env

# OpenAI API 키 (필수, gpt-4o-mini 사용 시)
OPENAI_API_KEY=sk-...

# Anthropic API 키 (선택사항, claude 모델 사용 시)
ANTHROPIC_API_KEY=sk-ant-...

# Google Cloud TTS 서비스 계정 (선택사항, Google TTS 사용 시)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
